# Required: https://console.typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Multi-step tasks (jev-agent / "Alfred, reply to Sam saying yes"): TYPE_TEXT values.
# With a key, a small OpenAI-compatible model writes the value (OpenRouter example below).
# Without one, Jev selects the value from spans cut out of your spoken goal (nothing generated).
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Task driver: browser (Chrome via CDP, jev-ultrafast; default) | desktop (Accessibility tree, experimental)
TASK_DRIVER=browser
TASK_START_URL=https://www.google.com
# Page size for the browser driver: fill (the confined monitor) or WxH, e.g. 1120x780 (jev-ultrafast's demo)
TASK_VIEWPORT=fill
# Keep the agent on one monitor: main | left | right | index. left/right follow the macOS Displays
# arrangement, which may not match the physical layout; main or an index is unambiguous.
AGENT_DISPLAY=

# Feedback after an action: ding (chime) | voice (spoken butler)
FEEDBACK=ding
# PERSONA=alfred (posh UK butler) | cowboy | plain ; USER_NAME is used in "master <name>"
PERSONA=alfred
USER_NAME=Wayne

# Optional better voice (ElevenLabs Flash, cached to disk). Defaults: alfred=George, cowboy=Bill
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Hands-free: names that address the assistant; follow-up window after a command (seconds)
WAKE_WORDS=alfred,jarvis,alfie,alford,elfred
FOLLOWUP_SECONDS=8
# Unnamed utterances: 1 = let Jev judge if it's a command; gates 0..1 (0 = never ignore)
UNNAMED_COMMANDS=1
UNNAMED_MIN_ADDRESSED=0
UNNAMED_MIN_CONFIDENCE=0

# OVERLAY=0 to hide the floating transcription pill
OVERLAY=1

# Cost display (USD per 1M tokens). Jev: docs.typesafe.ai/models (input only, output free).
JEV_PRICE_PER_MTOK_IN=0.042
# Text helper prices are model-specific; leave blank to show tokens only.
TEXT_MODEL_PRICE_IN=
TEXT_MODEL_PRICE_OUT=

# Fast Claude escalation (planner, TYPE_TEXT values, tie-breaker on weak/BLOCKED choices, DONE verifier).
# ESCALATE=0 disables; ESCALATE_PLAN=0 skips the checklist planner.
ANTHROPIC_API_KEY=
ESCALATE_MODEL=claude-fable-5-1
ESCALATE_FAST_MODEL=claude-haiku-4-5
# Haiku hands over to the strong model below this self-reported confidence
ESCALATE_FAST_MIN=0.5
# Effort for Claude 5 models: low | medium | high (planner and verifier use ESCALATE_EFFORT_PLAN / _VERIFY)
ESCALATE_EFFORT=low
ESCALATE_EFFORT_PLAN=medium
ESCALATE_EFFORT_VERIFY=medium
# Jev runs alone above this confidence unless it picks BLOCKED or a loop/no-progress signal fires (trust per site adjusts it)
ESCALATE_BELOW=0.6

# What "message the seller" sends (by voice). The CLI takes --message.
SELLER_MESSAGE=Hi! Is this still available?

# Chess: seconds to pause before each of our moves (±30% jitter); in learning mode the move also waits for the narration to finish
CHESS_MOVE_DELAY=5
CHESS_VOICE=1
CHESS_EXPLAIN=llm
